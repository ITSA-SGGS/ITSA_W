# =============================================================================
# ITSA BACKEND SERVER — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and configure the variables.
# NEVER commit real credentials or .env files to source control.

# 1. Server Port
PORT=5000

# 2. Client Origin (CORS whitelist for React frontend)
# In development: http://localhost:5173
# In production: https://itsa.sggs.ac.in
CLIENT_ORIGIN=http://localhost:5173

# 3. Neon PostgreSQL Connection String (Pooled connection with SSL)
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=

# 4. Authentication Secret (For future JWT/session signing - Phase 2)
AUTH_SECRET=

# 5. Node Environment (development | production | test)
NODE_ENV=development
