# =============================================================================
# ITSA BACKEND SERVER — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and configure the variables.
# NEVER commit real credentials or .env files to source control.

# 1. Server Port
PORT=5000

# 2. Client Origin (CORS whitelist for React frontend)
# In development: http://localhost:5173
# In production: https://itsa.sggs.ac.in
CLIENT_ORIGIN=http://localhost:5173

# 3. Neon PostgreSQL Connection String (Pooled connection with SSL)
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=

# 4. Authentication Secret (Mandatory in production: minimum 32 chars cryptographically random)
# Generate via: openssl rand -base64 32
AUTH_SECRET=

# 5. Session Configuration
SESSION_TTL_HOURS=24
COOKIE_NAME=itsa_session

# 6. Node Environment (development | production | test)
NODE_ENV=development

# =============================================================================
# 7. Object Storage Configuration (Phase 4 — Cloudflare R2 / S3-Compatible / Local)
# =============================================================================
# Provider selection: 'r2' | 's3' | 'local' | 'memory'
# In production: 'r2' is the preferred production object storage provider.
# In development: defaults to 'local' (or 'r2' if credentials provided).
STORAGE_PROVIDER=r2

# --- Cloudflare R2 Configuration (Production Recommended) ---
# Cloudflare Account ID (found in Cloudflare Dashboard URL or Overview page)
R2_ACCOUNT_ID=
# Cloudflare R2 API Token / S3-compatible Access Key ID
R2_ACCESS_KEY_ID=
# Cloudflare R2 S3-compatible Secret Access Key
R2_SECRET_ACCESS_KEY=
# Bucket name (single bucket with prefixes: team/, events/, archive/)
R2_BUCKET_NAME=itsa-media
# Public CDN URL mapped to bucket (e.g. https://media.itsa.sggs.ac.in or https://pub-<hash>.r2.dev)
R2_PUBLIC_URL=

# --- Generic S3 Fallback Configuration (if using AWS S3 / MinIO / Ceph instead of R2) ---
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# --- Local Storage Configuration ---
# Directory on local disk where files are stored when STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
