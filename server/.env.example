# =============================================================================
# ITSA BACKEND SERVER — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and configure the variables.
# NEVER commit real credentials or .env files to source control.

# 1. Server Port
PORT=5000

# 2. Client Origin (CORS whitelist for React frontend)
# In development: http://localhost:5173
# In production: https://itsa.sggs.ac.in
CLIENT_ORIGIN=http://localhost:5173

# 3. Neon PostgreSQL Connection String (Pooled connection with SSL)
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=

# 4. Authentication Secret (Mandatory in production: minimum 32 chars cryptographically random)
# Generate via: openssl rand -base64 32
AUTH_SECRET=

# 5. Session Configuration
SESSION_TTL_HOURS=24
COOKIE_NAME=itsa_session

# 6. Node Environment (development | production | test)
NODE_ENV=development

# =============================================================================
# 7. Object Storage Configuration (Tigris / S3-Compatible / Cloudflare R2 / Local)
# =============================================================================
# Provider selection: 'tigris' | 's3' | 'r2' | 'local' | 'memory'
# In production: 'tigris' (or 's3') is the production S3-compatible object storage provider.
# In development: defaults to 'local' (or 'tigris'/'s3' if credentials provided).
STORAGE_PROVIDER=tigris

# --- Tigris S3-Compatible Storage (Production Default) ---
# Tigris default endpoint is https://fly.storage.tigris.dev
TIGRIS_ENDPOINT=https://fly.storage.tigris.dev
TIGRIS_REGION=auto
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
TIGRIS_BUCKET_NAME=itsa-media

# Expiration in seconds for short-lived presigned GET URLs for private objects (default: 900 = 15 minutes)
STORAGE_SIGNED_URL_EXPIRES_SECONDS=900

# --- Generic S3 Fallback Configuration (if using AWS S3 / MinIO / Ceph instead of Tigris) ---
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL=

# --- Cloudflare R2 Fallback Configuration ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=itsa-media
R2_PUBLIC_URL=

# --- Local Storage Configuration ---
# Directory on local disk where files are stored when STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
