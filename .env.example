# =============================================================================
# ITSA WEB PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env or .env.local and populate with your Supabase project credentials.
# WARNING: NEVER commit .env or .env.local files containing real credentials to Git.

# 1. Public Supabase Endpoint (Safe for client-side use in Vite)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Public Supabase Anonymous Key (Safe for client-side use, governed by Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# CRITICAL SECURITY NOTE:
# The SUPABASE_SERVICE_ROLE_KEY bypasses all Row Level Security policies.
# It must NEVER be added to frontend environment files or client code.
# -----------------------------------------------------------------------------
